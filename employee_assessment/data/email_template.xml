<odoo>
    <data>

        <record id="email_template_assessment" model="mail.template">
            <field name="name">Assessment Result</field>
            <field name="model_id" ref="model_employee_assessment"/>
            <field name="subject">Assessment Result for ${object.name}</field>
            <field name="email_to">${object.email}</field>

            <field name="body_html" type="html">
                <div>
                    <p>Hello <t t-out="object.name"/>,</p>
                    <p>Your assessment results:</p>
                    <ul>
                        <li>Character: <t t-out="object.character"/></li>
                        <li>Punctuality: <t t-out="object.punctuality"/></li>
                        <li>Engagement: <t t-out="object.engagement"/></li>
                        <li>Skills: <t t-out="object.skills"/></li>
                    </ul>
                    <p>
                        <strong>
                            Final Score:
                            <t t-out="object.final_score"/>
                        </strong>
                    </p>
                    <p>Date: <t t-out="object.assessment_date"/></p>
                </div>
            </field>
        </record>

    </data>
</odoo>
