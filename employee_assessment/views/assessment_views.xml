<odoo>
    <!-- Tree View -->
    <record id="view_employee_assessment_tree" model="ir.ui.view">
        <field name="name">employee.assessment.tree</field>
        <field name="model">employee.assessment</field>
        <field name="arch" type="xml">
            <list>
                <field name="customer_id"/>
                <field name="name"/>
                <field name="department"/>
                <field name="final_score"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_employee_assessment_form" model="ir.ui.view">
        <field name="name">employee.assessment.form</field>
        <field name="model">employee.assessment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="customer_id"/>
                        <field name="name"/>
                        <field name="email"/>
                        <field name="department"/>
                    </group>

                    <group string="Assessment Criteria">
                        <field name="character"/>
                        <field name="punctuality"/>
                        <field name="engagement"/>
                        <field name="skills"/>
                    </group>

                    <group>
                        <field name="final_score" readonly="1"/>
                        <field name="assessment_date" readonly="1"/>
                    </group>

                    <footer>
                        <button name="action_compute_score"
                                string="Compute Score"
                                type="object"
                                class="btn-primary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_employee_assessment" model="ir.actions.act_window">
        <field name="name">Employee Assessments</field>
        <field name="res_model">employee.assessment</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_employee_assessment_root" name="Assessments"/>
    <menuitem id="menu_employee_assessment"
              name="Employee Assessment"
              parent="menu_employee_assessment_root"
              action="action_employee_assessment"/>
</odoo>
